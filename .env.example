# Clave para proteger la API. Si se deja vacía, la API queda abierta.
# Genera una con:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Segundos que se guarda cada consulta en caché (por defecto 600 = 10 min)
CACHE_TTL=600

# Puerto interno del contenedor (Coolify: "Ports Exposes" = 8000)
PORT=8000
